{
  "expo": {
    "name": "Financial Analytics",
    "slug": "financial-analytics",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ge.financial.analytics",
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "versionCode": 10
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the pairing QR code shown in the desktop app"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4F46E5"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class androidx.work.** { *; }\n-keep class androidx.room.** { *; }\n-keep class androidx.startup.** { *; }\n-keep class **_Impl { *; }\n-keep class expo.modules.** { *; }\n-keep class com.reactnativecommunity.webview.** { *; }\n-keep class com.google.firebase.** { *; }\n-dontwarn com.google.firebase.**"
          }
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "./plugins/withReleaseSigning"
    ],
    "scheme": "finance",
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
